  m_Script: {fileID: 11500000, guid: 119a645d648fe4a4c86c14f18251ec06, type: 3}
  m_Name: end_lumi
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  presentation: 0
  lines:
  - speaker: 
    portrait: {fileID: 0}
    text: You swallow the Golden Clam's light. Warmth floods through you, and golden
      paths unroll across the water toward a reef you almost remember.
  - speaker: Lumi
    portrait: {fileID: 21300000, guid: 25d3a49108ae92346a5bb5a64d9c8721, type: 3}
    text: Beautiful. Thank you, tang. The light needed a swallower. It could never
      leave the Clam any other way.
  - speaker: You
    portrait: {fileID: 21300000, guid: 24d008a2918cc544f87755498eae8b2b, type: 3}
    text: Lumi...?
  - speaker: Lumi
    portrait: {fileID: 21300000, guid: 25d3a49108ae92346a5bb5a64d9c8721, type: 3}
    text: Every shortcut has a price. Stay exactly where you are. The Deep is about
      to get very bright.
  - speaker: Marlo (echo)
    portrait: {fileID: 21300000, guid: 07b2589218cdd3147bc544ac1e97088a, type: 3}
    text: Little one, swim! Swim now!
  choices: []
