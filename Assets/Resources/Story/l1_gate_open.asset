  m_Script: {fileID: 11500000, guid: 119a645d648fe4a4c86c14f18251ec06, type: 3}
  m_Name: l1_gate_open
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  presentation: 0
  lines:
  - speaker: Marlo (echo)
    portrait: {fileID: 5496424915399974395, guid: 07b2589218cdd3147bc544ac1e97088a, type: 3}
    text: Do you feel that? The water is warming. The first ruin has woken, and the
      Lantern Road is alive again!
  - speaker: Marlo (echo)
    portrait: {fileID: 5496424915399974395, guid: 07b2589218cdd3147bc544ac1e97088a, type: 3}
    text: 'Now grow strong enough to leave the reef, little tang. And remember: a
      road is only as good as the friends you make on it.'
