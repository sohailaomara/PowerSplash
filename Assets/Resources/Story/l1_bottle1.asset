  m_Script: {fileID: 11500000, guid: 119a645d648fe4a4c86c14f18251ec06, type: 3}
  m_Name: l1_bottle1
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  presentation: 0
  lines:
  - speaker: Message in a Bottle
    portrait: {fileID: 7852321668722200817, guid: 83040dd603cf240459b6ea4398cca1b2, type: 3}
    text: 'To whoever finds this: the storm took my whole school. I followed the
      Lantern Road south, one ruin at a time, and it is real. Three pearls wake each
      ruin.'
  - speaker: Message in a Bottle
    portrait: {fileID: 7852321668722200817, guid: 83040dd603cf240459b6ea4398cca1b2, type: 3}
    text: Beware the lantern-fish of the Open Water. His shortcuts are never free.
  - speaker: Message in a Bottle
    portrait: {fileID: 7852321668722200817, guid: 83040dd603cf240459b6ea4398cca1b2, type: 3}
    text: And if you meet a little clownfish named Pip, please tell him his mother
      is still searching for him.
  choices: []
  flagToSetWhenFinished: 
  abilityWhenFinished: 0
  journalTitle: 'Bottle 1: A Traveler''s Warning'
