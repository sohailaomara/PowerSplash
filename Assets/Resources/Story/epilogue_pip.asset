  m_Script: {fileID: 11500000, guid: 119a645d648fe4a4c86c14f18251ec06, type: 3}
  m_Name: epilogue_pip
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  presentation: 1
  lines:
  - speaker: 
    portrait: {fileID: 0}
    text: The little tang and the little clownfish followed the golden current home.
  - speaker: 
    portrait: {fileID: 0}
    text: Pip's mother was waiting at the edge of the reef, and a school of yellow
      tang swam out to meet them.
  - speaker: 
    portrait: {fileID: 0}
    text: Some roads are lit by light. The best ones are lit by the fish who walk
      them with you.
  - speaker: 
    portrait: {fileID: 0}
    text: THE END
