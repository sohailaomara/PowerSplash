  m_Script: {fileID: 11500000, guid: 119a645d648fe4a4c86c14f18251ec06, type: 3}
  m_Name: l2_pip_first
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  presentation: 0
  lines:
  - speaker: Pip
    portrait: {fileID: 5321500989998449891, guid: f3c5a07a818135f469b115ad655a7cd8, type: 3}
    text: Shh! Do not let Lumi see me. He says he knows the way home, but he looks
      at me like I am a snack.
  - speaker: Pip
    portrait: {fileID: 5321500989998449891, guid: f3c5a07a818135f469b115ad655a7cd8, type: 3}
    text: I am Pip. The storm swept me away from my mom. I have been hiding behind
      this rock ever since.
